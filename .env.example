# Database connection (use internal service name in Docker Compose)
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/knowledge_extraction

# Anthropic API key
ANTHROPIC_API_KEY=your-api-key-here

# CORS origins — comma-separated list of allowed frontend origins.
# Use "*" to allow all (development only). Set specific origins in production.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# Directory where cloned repositories are stored.
# In Docker this path is inside the container; mount a named volume there.
# Default: .repos
# REPOS_ROOT_DIR=.repos

# Logging level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
